#!/usr/bin/env bash
#
# pre-commit: fast checks on staged Go changes in the root module
#
# - gofmt check (does not rewrite staged files)
# - go test for affected packages
#
# Bypass: git commit --no-verify

set -euo pipefail

ROOT=$(git rev-parse --show-toplevel)
cd "$ROOT"
STAGED_GO=()
while IFS= read -r -d '' path; do
  if [[ "$path" == *.go ]]; then
    STAGED_GO+=("$path")
  fi
done < <(git diff --cached --name-only -z --diff-filter=ACMR)

if [ "${#STAGED_GO[@]}" -eq 0 ]; then
  exit 0
fi

echo "[pre-commit] gofmt check..."
UNFMT=()
for f in "${STAGED_GO[@]}"; do
  diff=$(git show ":$f" | gofmt -d)
  if [ -n "$diff" ]; then
    UNFMT+=("$f")
  fi
done
if [ "${#UNFMT[@]}" -ne 0 ]; then
  echo "[pre-commit] gofmt required for:" "${UNFMT[@]}"
  echo "  run: gofmt -w ${UNFMT[*]}"
  exit 1
fi

PKGS=()
for f in "${STAGED_GO[@]}"; do
  dir=$(dirname "$f")
  if [ "$dir" = "." ]; then
    PKGS+=("./...")
    break
  fi
  PKGS+=("./$dir/...")
done

UNIQ_PKGS=$(printf '%s\n' "${PKGS[@]}" | sort -u)

echo "[pre-commit] go test ${UNIQ_PKGS[*]}"
while IFS= read -r pkg; do
  go test "$pkg"
done <<< "$UNIQ_PKGS"

echo "[pre-commit] OK"
