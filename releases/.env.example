# CodeBuddy 纯协议反代网关（Go）
# 复制为 .env 后双击/运行二进制即可；也可不手动创建——
# 首次启动若没有 API Key，程序会自动生成并写入同目录 .env。

CODEBUDDY_PROXY_HOST=127.0.0.1
CODEBUDDY_PROXY_PORT=32126

# 本地也建议开着；客户端填同样的 Key
CODEBUDDY_PROXY_REQUIRE_API_KEY=true
# 可留空：首次启动自动生成 cbp_... 并写入本文件
CODEBUDDY_PROXY_API_KEY=
# 管理台密码；留空则管理台免密（推荐本地）。API Key 仍可单独开启。
CODEBUDDY_PROXY_ADMIN_PASSWORD=

# 账号池（OAuth Bearer）
CODEBUDDY_PROXY_ACCOUNTS_PATH=~/.codebuddy/proxy-accounts.json

# 站点 / 区域（管理台可一键切换号池；请求只使用当前区域账号）
CODEBUDDY_SITE=domestic
CODEBUDDY_INTERNET_ENVIRONMENT=internal
CODEBUDDY_BASE_URL=https://www.codebuddy.cn
# 上游产品（管理台可一键切换；codebuddy=CLI 头，workbuddy=IDE 头）
CODEBUDDY_PRODUCT=codebuddy

# 可选：公网访问地址（OAuth 回调）
# CODEBUDDY_PROXY_PUBLIC_BASE_URL=https://your-host.example.com

# 可选：流式 keep-alive（毫秒）
# CODEBUDDY_PROXY_STREAM_KEEPALIVE_MS=15000
