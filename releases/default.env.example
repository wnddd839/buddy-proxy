# CodeBuddy 纯协议反代网关（Go）
# 复制为 .env 后双击/运行二进制即可；也可不手动创建——
# 首次启动若没有 API Key，程序会自动生成并写入同目录 .env。

CODEBUDDY_PROXY_HOST=127.0.0.1
CODEBUDDY_PROXY_PORT=32126
# 可选：公开推理接口 JSON 上限（MiB），默认 64；放大前确认内存与反代上限。
# CODEBUDDY_PROXY_MAX_BODY_MB=64
# 可选：HTTP keep-alive 空闲超时（毫秒），默认 120000，不限制活跃 SSE。
# CODEBUDDY_PROXY_SERVER_IDLE_TIMEOUT_MS=120000
# 可选：SIGINT/SIGTERM 优雅关闭宽限期（毫秒），默认 600000；不影响自更新交接。
# CODEBUDDY_PROXY_SHUTDOWN_GRACE_MS=600000

# 本地也建议开着；客户端填同样的 Key
CODEBUDDY_PROXY_REQUIRE_API_KEY=true
# 可留空：首次启动自动生成 cbp_... 并写入本文件
CODEBUDDY_PROXY_API_KEY=
# 可选：多 Key 绑区域。换 Key 等于换区，/v1/models 只返回该区无前缀目录
# CODEBUDDY_PROXY_API_KEYS=cbp_aaa:global,cbp_bbb:domestic
# 固定账号：CODEBUDDY_PROXY_API_KEYS=cbp_fixed:account=<账号池中的id>
# 固定账号不可用时明确失败，不自动切换其他账号；区域由账号推导。
# 管理台密码；留空则管理台免密（推荐本地）。API Key 仍可单独开启。
CODEBUDDY_PROXY_ADMIN_PASSWORD=

# 账号池（OAuth Bearer）
CODEBUDDY_PROXY_ACCOUNTS_PATH=~/.codebuddy/proxy-accounts.json

# 站点 / 区域（管理台可切换默认号池；单请求可用 Key 绑定 / X-Site / cn: 前缀覆盖）
CODEBUDDY_SITE=domestic
CODEBUDDY_INTERNET_ENVIRONMENT=internal
CODEBUDDY_BASE_URL=https://www.codebuddy.cn
# 上游产品（管理台可一键切换；codebuddy=CLI 头，workbuddy=IDE 头）
CODEBUDDY_PRODUCT=codebuddy

# 可选：公网访问地址（OAuth 回调）
# CODEBUDDY_PROXY_PUBLIC_BASE_URL=https://your-host.example.com

# 可选：国际站 OAuth 专用出口（auth/state、auth/token 与 token refresh 都走它）
# 国内站与普通推理调用不受影响；为空时沿用默认客户端
# CODEBUDDY_PROXY_OAUTH_PROXY=socks5h://127.0.0.1:17998

# 可选：流式 keep-alive（毫秒）
# CODEBUDDY_PROXY_STREAM_KEEPALIVE_MS=15000

# 可选：每账号自动签到总开关（默认关闭）。规则在管理台「客户端接入 → 自动签到」配置，
# 保存到账号池同目录 proxy-checkin.json；时间统一北京时间，启动不补签。
# CODEBUDDY_PROXY_CHECKIN_AUTO=true
